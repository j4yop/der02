{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'Vercel auto-detects the FastAPI entrypoint via [tool.vercel] in pyproject.toml'",
  "functions": {
    "api.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,examples/**,.scratch/**,public/**,app.py,streamlit_app.py,DEPLOY.md,DEMO.md,README.md,CITATIONS.md,SPEC.md,vercel.json,requirements.txt,.streamlit/**,.github/**}"
    }
  }
}
